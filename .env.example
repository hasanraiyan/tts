# Copy to .env for local development. Never commit real secrets.
# On Render, configure these under Environment / Environment Groups.

# Application
APP_NAME=ai-tts-service
APP_VERSION=1.0.0
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Authentication
# One variable per consuming application: API_KEY_<CLIENT_ID>
# API_KEY_MINDPAGEREADS=
# API_KEY_COURSIFY=
# API_KEY_DEFAULT=
API_KEY=

# Hugging Face
# Required for private or gated model repos; optional for public models.
HF_TOKEN=

# TTS runtime: onnx = 370MB (fits Render free tier), torch = fp32 (needs 1.3GB)
TTS_PROVIDER=onnx
ONNX_MODEL_DIR=/app/models/kokoro-int8-multi-lang-v1_0
ONNX_NUM_THREADS=1

# Only used by the optional torch provider
MODEL_ID=hexgrad/Kokoro-82M
MODEL_REVISION=f3ff3571791e39611d31c381e3a41a3af07b4987
MODEL_WEIGHTS_FILE=kokoro-v1_0.pth

# Hugging Face cache location
HF_HOME=/app/.cache/huggingface

# TTS defaults and capabilities
DEFAULT_LANGUAGE=en
DEFAULT_VOICE=af_heart
DEFAULT_FORMAT=mp3
SUPPORTED_FORMATS=mp3,wav
MAX_TEXT_LENGTH=5000
SAMPLE_RATE=24000
DEFAULT_SPEED=1.0

# Runtime / protection
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENCY=1
QUEUE_TIMEOUT_SECONDS=120
TORCH_NUM_THREADS=4
PRELOAD_MODEL=true
